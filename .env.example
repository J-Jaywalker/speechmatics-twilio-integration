# Copy to .env and fill in your values.

# Speechmatics Realtime API key. https://portal.speechmatics.com/
SPEECHMATICS_API_KEY=

# ngrok auth token, used to expose the local server so Twilio can reach it.
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Twilio credentials + the E.164 number that receives inbound calls. On
# startup proxy.py points this number's Voice URL at the ngrok tunnel,
# and restores the previous URL on shutdown.
# Find these in the Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# E.164 number the <Dial> bridges the caller to - the second human in
# the two-party conversation being transcribed.
FORWARD_TO_NUMBER=

# Optional. Local server port. Default: 5000.
SM_TWILIO_PROXY_PORT=5000
